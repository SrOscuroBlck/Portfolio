---
import "@fontsource-variable/instrument-sans";
import "@fontsource/instrument-serif";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import SparklesCore from "../components/SparklesCore.tsx";
import Starfield from "../components/starfield/index.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const description =
  "Gustavo Camargo — backend software engineer building serverless, event-driven systems on AWS. Based in Cali, Colombia, working with teams across the Americas and Europe.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/me.jpeg" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      // Marks JS availability so [data-reveal] elements are only hidden when the reveal script can run
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body
    class="bg-black font-sans leading-relaxed text-neutral-200 tracking-wide antialiased selection:bg-neutral-300 selection:text-neutral-900 z-10 relative"
  >
    <SparklesCore
      client:idle
      id="tsparticlesfullpage"
      background="transparent"
      minSize={0.6}
      maxSize={1.4}
      opacity={0.2}
      particleDensity={100}
      className="w-full h-full fixed z-0"
      particleColor="#FFFFFF"
    />
    <Starfield />
    <slot />
    <script src="../scripts/main.ts"></script>
  </body>

  <style is:global>
    html {
      background-size: 224px;
      font-size: 1.125rem;
    }

    @media (prefers-reduced-motion: no-preference) {
      html {
        scroll-behavior: smooth;
      }
    }

    /* Terminal-style caret blink (distinct from the slower available-dot pulse) */
    @keyframes caret-blink {
      0%,
      49% {
        opacity: 1;
      }
      50%,
      100% {
        opacity: 0;
      }
    }

    .caret-blink {
      animation: caret-blink 1.2s steps(1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .caret-blink {
        animation: none;
      }
    }

    /* Active section in the rail nav (toggled by the scrollspy in main.ts):
       brightens and pops, settling slightly enlarged */
    .nav-link.is-active {
      color: rgb(134 239 172); /* green-300 — the site's accent */
      animation: nav-pop 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @keyframes nav-pop {
      0% {
        transform: scale(1);
      }
      45% {
        transform: scale(1.22);
      }
      100% {
        transform: scale(1.1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .nav-link.is-active {
        animation: none;
      }
    }

    /* Brief ring flash when a globe card deep-links to an experience entry */
    .flash-highlight {
      animation: flash-highlight 1.6s ease-out;
      border-radius: 0.375rem;
    }

    @keyframes flash-highlight {
      0%,
      45% {
        box-shadow:
          0 0 0 1px rgba(74, 222, 128, 0.45),
          inset 0 0 24px rgba(74, 222, 128, 0.06);
      }
      100% {
        box-shadow:
          0 0 0 1px rgba(74, 222, 128, 0),
          inset 0 0 24px rgba(74, 222, 128, 0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .flash-highlight {
        animation: none;
        box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.45);
      }
    }

    .js [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 0.65s ease-out,
        transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: var(--reveal-delay, 0ms);
    }

    .js [data-reveal].is-visible {
      opacity: 1;
      transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .js [data-reveal] {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>
</html>

---
import Component from "../components/Component.astro";
import Experience from "../components/experience/index.astro";
import { EXPERIENCE } from "../data/experience";
import { PROJECTS } from "../data/projects";
import { SOCIALS } from "../data/socials";
import Layout from "../layouts/Layout.astro";
import Globe from "../components/globe/index.astro";

const NAV_LINKS = [
  { id: "about", label: "About" },
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
];
---

<Layout title="Gustavo Camargo — Backend Software Engineer">
  <div class="relative hero z-10">
    <div
      class="mx-auto min-h-screen max-w-screen-2xl px-6 py-12 font-sans md:px-12 md:py-20 lg:px-24 lg:py-0"
    >
      <div class="lg:flex lg:justify-between lg:gap-4">
        <header
          class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[42%] lg:flex-col lg:justify-between lg:py-12"
        >
          <div
            class="flex flex-col items-center text-center lg:items-start lg:text-left"
            data-reveal
          >
            <div class="flex flex-col items-center gap-4 lg:flex-row">
              <img
                src="/me.jpeg"
                alt="Gustavo Camargo"
                class="w-24 h-24 shrink-0 rounded-full object-cover ring-1 ring-neutral-700/50"
                width="96"
                height="96"
              />
              <div>
                <a
                  href="/"
                  class="text-4xl lg:text-[clamp(1.875rem,3vw,3rem)] whitespace-nowrap leading-[1.15] block font-normal tracking-tight bg-clip-text text-transparent bg-gradient-to-b from-neutral-50 to-neutral-400 bg-opacity-50"
                >
                  <h1>Gustavo Camargo</h1>
                </a>
                <h2
                  class="mt-3 font-mono text-xs lg:text-sm uppercase tracking-widest text-neutral-400"
                  aria-label="Software Engineer · Backend"
                >
                  <span class="typewriter-text" aria-hidden="true"
                    >Software Engineer · Backend</span
                  ><span
                    class="caret-blink ml-1 inline-block h-3 w-[7px] translate-y-0.5 bg-green-400/70"
                    aria-hidden="true"></span>
                </h2>
              </div>
            </div>
          </div>

          <div data-reveal style="--reveal-delay: 120ms">
            <Globe />
          </div>

          {
            SOCIALS.length && (
              <ul
                class="mt-8 flex items-center justify-center lg:justify-normal gap-x-5"
                aria-label="Social media"
                data-reveal
                style="--reveal-delay: 240ms"
              >
                {SOCIALS.map((social) => (
                  <li class="text-xs p-2 rounded" data-ccursor>
                    <a
                      class="block hover:text-slate-200 transition-transform duration-250 ease-out-soft hover:-translate-y-1 motion-reduce:transition-none motion-reduce:transform-none"
                      href={social.url}
                      target="_blank"
                      rel="noreferrer noopener"
                      aria-label={`${social.name} (opens in a new tab)`}
                    >
                      <span class="sr-only">{social.name}</span>
                      {<Component component={social.icon} />}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <aside
          class="hidden lg:sticky lg:top-0 lg:flex lg:h-screen lg:flex-col lg:items-center lg:px-10"
          aria-label="Section navigation"
        >
          <div
            class="w-px flex-1 bg-gradient-to-b from-transparent to-neutral-800"
            aria-hidden="true"
          >
          </div>
          <nav>
            <ul class="flex flex-col items-center gap-7 py-8">
              {
                NAV_LINKS.map(({ id, label }) => (
                  <li class="flex justify-center">
                    <a
                      href={`#${id}`}
                      class="nav-link block text-center font-mono text-base uppercase tracking-widest text-neutral-500 transition-colors duration-250 hover:text-neutral-200 motion-reduce:transition-none"
                    >
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div
            class="w-px flex-1 bg-gradient-to-t from-transparent to-neutral-800"
            aria-hidden="true"
          >
          </div>
          <div
            class="scroll-hint flex flex-col items-center gap-1 pb-4 pt-2 opacity-100 transition-opacity duration-400 motion-reduce:transition-none"
            aria-hidden="true"
          >
            <span
              class="font-mono text-[10px] uppercase tracking-widest text-neutral-500"
            >
              Scroll
            </span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-3.5 w-3.5 animate-bounce text-neutral-500 motion-reduce:animate-none"
            >
              <path
                fill-rule="evenodd"
                d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
        </aside>

        <main id="content" class="pt-24 lg:w-1/2 lg:py-24">
          <section
            id="about"
            class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
            aria-label="About me"
          >
            <div
              class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-3 backdrop-blur-lg md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"
            >
              <h2
                class="font-mono text-xs font-medium uppercase tracking-widest text-neutral-200 lg:sr-only"
              >
                About
              </h2>
            </div>
            <div data-reveal>
              <div class="mb-4 space-y-4">
                <p>
                  I’m a Software Engineer specializing in backend systems, cloud
                  computing, and AI-driven automation. Currently working on AWS
                  serverless development at <strong>BookHub</strong>, leading
                  chatbot automation for healthcare at <strong
                    >BAST Automation</strong
                  >, and developing real estate and medical solutions at
                  <strong>Priver Group</strong>.
                </p>
                <p>
                  Passionate about building scalable software and driving
                  entrepreneurial innovation, I’m also the founder of <strong
                    >TasteBud</strong
                  >, an AI-powered restaurant recommendation platform. Always up
                  for new challenges, I thrive on creating solutions that merge <strong
                    >technology and real-world impact</strong
                  >.
                </p>

                <p>Ready for what’s next—bring on the challenges!</p>
              </div>
            </div>
          </section>
          <section
            id="experience"
            class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
            aria-label="Work experience"
          >
            <div
              class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-3 backdrop-blur-lg md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"
            >
              <h2
                class="font-mono text-xs font-medium uppercase tracking-widest text-neutral-200 lg:sr-only"
              >
                Experience
              </h2>
            </div><div>
              <ol class="group/list space-y-12">
                {EXPERIENCE.map((experience) => <Experience {...experience} />)}
              </ol>
            </div>
          </section>
          <section
            id="projects"
            class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24"
            aria-label="Projects"
          >
            <div
              class="sticky top-0 z-20 -mx-6 mb-4 w-screen px-6 py-3 backdrop-blur-lg md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0"
            >
              <h2
                class="font-mono text-xs font-medium uppercase tracking-widest text-neutral-200 lg:sr-only"
              >
                Projects
              </h2>
            </div>
            <div>
              <ol class="group/list space-y-12">
                {PROJECTS.map((project) => <Experience {...project} />)}
              </ol>

              <div class="mt-12" data-reveal>
                <a
                  data-ccursor
                  class="inline-flex items-center leading-tight text-neutral-200 font-semibold group p-2 rounded px-3"
                  aria-label="View Full Résumé"
                  target="_blank"
                  rel="noreferrer noopener"
                  href="./resume.pdf"
                >
                  <span>
                    <span
                      class="border-b border-transparent pb-px transition group-hover:border-neutral-300 motion-reduce:transition-none"
                    >
                      View Full
                    </span>
                    <span class="whitespace-nowrap">
                      <span
                        class="border-b border-transparent pb-px transition group-hover:border-neutral-300 motion-reduce:transition-none"
                      >
                        Résumé
                      </span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="ml-1 inline-block h-4 w-4 shrink-0 -translate-y-px transition-transform group-hover:translate-x-2 group-focus-visible:translate-x-2 motion-reduce:transition-none"
                        aria-hidden="true"
                        ><path
                          fill-rule="evenodd"
                          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                          clip-rule="evenodd"></path></svg
                      ></span
                    ></span
                  ></a
                >
              </div>
            </div>
          </section>
          <footer
            class="max-w-md pb-16 text-sm text-neutral-500 sm:pb-0"
            data-reveal
          >
            <p>
              Built with
              <a
                href="https://astro.build/"
                class="font-medium text-neutral-400 hover:text-violet-300 focus-visible:text-violet-300 hover:underline"
                target="_blank"
                rel="noreferrer">Astro</a
              >
              ,
              <a
                href="https://threejs.org/"
                class="font-medium text-neutral-400 hover:text-blue-300 focus-visible:text-blue-300 hover:underline"
                target="_blank"
                rel="noreferrer">Three.js</a
              >
              and
              <a
                href="https://tailwindcss.com/"
                class="font-medium text-neutral-400 hover:text-cyan-300 focus-visible:text-cyan-300 hover:underline"
                target="_blank"
                rel="noreferrer">Tailwind CSS</a
              >
              . Hosted on
              <a
                href="https://netlify.com/"
                class="font-medium text-neutral-400 hover:text-purple-300 focus-visible:text-purple-300 hover:underline"
                target="_blank"
                rel="noreferrer">Netlify</a
              >
              .
            </p>
          </footer>
        </main>
      </div>
    </div>
  </div>

  <div
    class="scroll-hint fixed bottom-5 left-1/2 z-30 flex -translate-x-1/2 flex-col items-center gap-1 opacity-100 transition-opacity duration-400 motion-reduce:transition-none lg:hidden"
    aria-hidden="true"
  >
    <span class="text-[10px] uppercase tracking-widest text-neutral-500">
      Scroll
    </span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      class="h-4 w-4 animate-bounce text-neutral-500 motion-reduce:animate-none"
    >
      <path
        fill-rule="evenodd"
        d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z"
        clip-rule="evenodd"></path>
    </svg>
  </div>

  <footer class="text-center py-4 text-xs">
    {new Date().getFullYear()} All rights reserved.
  </footer>
</Layout>

<style scoped>
  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  /* Grid pattern removed deliberately — it could never align with the
     viewport-dependent nav rail; the particle field carries the background */
  .hero {
    overflow-y: visible;
    overflow-x: clip;
  }

  /*
  .hero {
    animation: fadeIn 3s;
  }
   */
</style>
